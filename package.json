{
  "name": "taskbook",
  "version": "1.2.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
	"build": "vite build && vite build --config vite.pwa.config.ts && vite build --config vite.pwa-worker.config.ts",
	"dev": "vite --mode development build && vite --mode development build --config vite.pwa.config.ts && vite --mode development build --config vite.pwa-worker.config.ts",
	"lint": "eslint src vite.config.ts vite.pwa.config.ts vite.pwa-worker.config.ts",
    "stylelint": "stylelint src/**/*.vue src/**/*.scss src/**/*.css",
    "test:unit": "vitest run",
    "typecheck": "vue-tsc --noEmit",
	"watch": "vite --mode development build --watch",
	"watch:pwa": "vite --mode development build --watch --config vite.pwa.config.ts"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
	"@mdi/js": "^7.4.47",
	"@nextcloud/axios": "^2.6.0",
	"@nextcloud/dialogs": "^7.4.1",
	"@nextcloud/l10n": "^3.4.1",
	"@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.8.2",
	"vue": "^3.5.35",
	"vue-router": "^5.1.0"
  },
  "devDependencies": {
	"@typescript-eslint/eslint-plugin": "^8.67.0",
	"@typescript-eslint/parser": "^8.67.0",
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/stylelint-config": "^3.1.1",
    "@nextcloud/vite-config": "^2.5.2",
    "@vue/tsconfig": "^0.9.1",
	"eslint": "^10.8.0",
	"postcss-html": "^1.8.1",
	"postcss-scss": "^4.0.9",
	"stylelint": "^17.14.1",
	"stylelint-config-recommended-scss": "^17.0.1",
	"stylelint-config-recommended-vue": "^1.6.1",
	"typescript": "^7.0.2",
	"vite": "^7.3.2",
	"vitest": "^4.0.18",
	"vue-eslint-parser": "^10.4.1",
	"vue-tsc": "^3.0.8"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.3.0"
  }
}
